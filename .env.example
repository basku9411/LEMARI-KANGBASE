VITE_FIREBASE_API_KEY=isi_api_key
VITE_FIREBASE_AUTH_DOMAIN=project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=project-id
VITE_FIREBASE_STORAGE_BUCKET=project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=isi_sender_id
VITE_FIREBASE_APP_ID=isi_app_id
# UID akun pemilik dari Firebase Authentication (untuk menampilkan panel admin)
VITE_ADMIN_UID=UID_AKUN_PEMILIK
# Instruksi transfer/QRIS yang ditampilkan kepada calon anggota
VITE_PAYMENT_INSTRUCTIONS=Transfer Rp50.000 ke rekening/QRIS milik pemilik aplikasi. Hubungi admin untuk detail pembayaran.
