rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // GANTI dengan UID akun pemilik dari Firebase Authentication.
    function isOwner() { return request.auth != null && request.auth.uid == 'GANTI_DENGAN_UID_PEMILIK'; }
    function isSelf(userId) { return request.auth != null && request.auth.uid == userId; }
    function isApproved(userId) {
      return isOwner() || (isSelf(userId) && get(/databases/$(database)/documents/users/$(userId)).data.status == 'approved');
    }
    match /users/{userId} {
      allow read: if isSelf(userId) || isOwner();
      allow create: if isSelf(userId)
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentAmount == 50000
        && request.resource.data.keys().hasOnly(['email','status','createdAt','paymentAmount']);
      // Anggota hanya boleh mengirim/mengganti data bukti bayar. Status hanya owner yang boleh mengubah.
      allow update: if isOwner() || (isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentProofUrl','paymentProofPath','paymentSubmittedAt']));
      allow delete: if isOwner();
      match /items/{itemId} {
        allow read, write: if isApproved(userId) && isSelf(userId);
      }
      match /folders/{folderId} {
        allow read, write: if isApproved(userId) && isSelf(userId);
      }
    }
  }
}
