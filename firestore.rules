rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.uid == 'TdRrSnNluBOJCgnY3aRzBKMNlpZ2'; }
    function isSelf(userId) { return signedIn() && request.auth.uid == userId; }
    function approved(userId) {
      return isOwner() || (isSelf(userId)
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.status == 'approved');
    }

    match /users/{userId} {
      allow get: if isOwner() || isSelf(userId);
      allow list: if isOwner();
      allow create: if isSelf(userId)
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentAmount == 50000
        && request.resource.data.keys().hasOnly(['email','status','createdAt','paymentAmount']);
      allow update: if isOwner()
        || (isSelf(userId)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'paymentProofPublicId','paymentProofResourceType','paymentProofFormat','paymentSubmittedAt'
          ]));
      allow delete: if isOwner();

      match /items/{itemId} {
        allow read, write: if isSelf(userId) && approved(userId);
      }
      match /folders/{folderId} {
        allow read, write: if isSelf(userId) && approved(userId);
      }
    }
  }
}
