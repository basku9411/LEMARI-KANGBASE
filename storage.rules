rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() { return request.auth != null && request.auth.uid == 'GANTI_DENGAN_UID_PEMILIK'; }
    function approved(userId) {
      return isOwner() || firestore.get(/databases/(default)/documents/users/$(userId)).data.status == 'approved';
    }
    match /users/{userId}/{fileName=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId && approved(userId);
      allow create, update: if request.auth != null && request.auth.uid == userId && approved(userId)
        && request.resource.size < 100 * 1024 * 1024;
    }
    match /payment-proofs/{userId}/{fileName=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isOwner());
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isOwner() || (request.auth != null && request.auth.uid == userId);
    }
  }
}
